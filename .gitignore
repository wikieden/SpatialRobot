# Workspace root — tracks the 3 submodules + shared config only.
# Each submodule has its own .gitignore for its source tree.

# uv shared environment (lockfile IS committed for reproducibility)
.venv/
__pycache__/
*.py[cod]

# Test artifacts
.coverage

# Agent / tooling state
.omc/
.omx/
.claude/
.codegraph/
.cursor/

# Chronotope stores
*.smem
*.smem-wal
*.smem-shm

# Env / secrets
.env
.env.local

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# editor/app backups
*.bak

# Decks / slides — local only, never commit
*.pptx
*.ppt
*.key
~$*
